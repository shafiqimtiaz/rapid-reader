{
  "name": "rapid-read",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-icons.mjs && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts && vite build --config vite.options.config.ts && cp manifest.json dist/manifest.json",
    "dev:content": "vite build --config vite.content.config.ts --watch",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^28.0.3",
    "eslint": "^9.0.0",
    "globals": "^17.9.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3"
  }
}
